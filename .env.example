# Copy this file to .env and fill in your real values.
# .env is gitignored; .env.example is the only env file committed to the repo.

# --- Cloudflare R2 (object storage) ---
# Get these from the Cloudflare R2 dashboard:
#   https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# Create an API token scoped to the bucket you want to use.

# Your Cloudflare account ID -- 33-char hex string visible on any R2 page.
R2_ACCOUNT_ID=

# Access Key ID and Secret from the API token you created.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Default bucket name. Used by shared.storage helpers when no bucket is passed.
# Create it once in the dashboard, e.g. "kaggle-data".
R2_BUCKET=
